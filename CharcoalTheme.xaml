<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Цветовая палитра: Dark Charcoal -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#202024"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#27272A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="GridRowBrush" Color="#27272A"/>
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#18181B"/>
</ResourceDictionary>