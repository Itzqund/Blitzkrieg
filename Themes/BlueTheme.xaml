<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Цветовая палитра: Midnight Blue -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A222B"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#161E27"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="GridRowBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#162032"/>
</ResourceDictionary>